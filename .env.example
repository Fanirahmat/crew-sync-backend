# Server Configuration
PORT=5001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crewsync_db?schema=public"

# Authentication (JWT)
JWT_SECRET="crewsync_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Firebase Cloud Messaging (FCM)
# Optional in dev: if not set, FCM notifications will be logged to console in mock mode
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# ngrok Tunnel Configuration (Share Localhost Publicly)
# Get your free token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=""
NGROK_DOMAIN=""
